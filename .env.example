# Frontend build-time variables
VITE_SUPABASE_URL="https://supabase.example.com"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="selfhost-example"

# Optional deployment metadata
APP_PUBLIC_URL="https://performance.example.com"

# Database backup / restore variables
DB_HOST="127.0.0.1"
DB_PORT="54322"
DB_NAME="postgres"
DB_USER="postgres"
DB_PASSWORD="please-change-me"
BACKUP_DIR="./backups/postgres"

# Storage backup / restore variables
STORAGE_DIR="/srv/performance-supabase/storage"
STORAGE_BACKUP_DIR="./backups/storage"

# Edge Function secrets to be configured in Supabase
SUPABASE_URL="https://supabase.example.com"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"
AI_API_KEY=""
AI_CHAT_BASE_URL="https://ai.gateway.lovable.dev/v1/chat/completions"
AI_MODEL_DEFAULT=""
AI_MODEL_REPORT=""
AI_MODEL_RECTIFICATION=""
AI_MODEL_EVALUATION_PLAN=""
AI_MODEL_MEETING_ANALYSIS=""
AI_MODEL_MATERIAL_MATCH=""
AI_MODEL_MATERIAL_COMPLETENESS=""
AI_MODEL_REPORT_REWRITE=""
AI_MODEL_TRANSCRIPTION="qwen3-asr-flash"
# 阿里百炼 / DashScope 录音转写接口。若使用 DASHSCOPE_API_KEY，建议显式配置该地址。
AI_TRANSCRIPTION_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions"
DASHSCOPE_API_KEY=""
AI_MODEL_EXPERT_NOTICE=""
LOCAL_ASR_BASE_URL=""
ENABLE_DOCUMENT_EXTRACTOR="true"
DOCUMENT_EXTRACTOR_BASE_URL="http://127.0.0.1:8091"
LOCAL_OCR_BASE_URL=""
DOCUMENT_EXTRACTOR_TIMEOUT_MS="120000"
EXTRACT_TEXT_MAX_CHARS="120000"
SHEET_EXTRACT_MAX_ROWS="2000"
OCR_LANG="chi_sim+eng"
OCR_MAX_PAGES="120"
OCR_DPI="220"
OCR_MIN_CHARS="80"
OCR_MAX_CONCURRENT="1"
VISION_OCR_API_KEY=""
VISION_OCR_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions"
VISION_OCR_MODEL="qwen-vl-ocr-latest"
VISION_OCR_TIMEOUT_SECONDS="50"
VISION_OCR_MIN_CONFIDENCE="55"
# Backward compatibility only. If AI_API_KEY is set, it takes precedence.
LOVABLE_API_KEY=""
AMAP_JSCODE=""

# Tencent Cloud SMS Edge Function secrets
# 腾讯云短信必须先在控制台完成短信签名和正文模板审核。
